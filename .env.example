# Copy this file to ".env" and edit it.  Nothing here is required: with no
# .env at all the agent runs fully deterministically and reaches only the
# public bibliographic services.

# --- Local model (optional) ------------------------------------------------
# Off unless you turn it on.  A model may classify, segment or verify; it is
# never allowed to author a bibliographic fact — DOIs, years, volumes, page
# ranges and venues come from Crossref, DataCite and refs.jacow.org and are
# verified before they are shown.
LLM_ENABLED=false

# Ollama (the default).  Start it with `ollama serve`, and pull a model with
# e.g. `ollama pull qwen3:14b`.  Any OpenAI-compatible server works:
# LM Studio is http://localhost:1234/v1.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:14b
LLM_API_KEY=ollama

# How many samples must agree before a label is used.  Unanimity, not
# majority: two out of three is exactly where a small model is guessing.
LLM_SAMPLES=3

# Temperature the samples are drawn at.  Leave unset: the default is 0.3 for
# repeated samples, because three samples drawn at 0 are the same answer three
# times and prove nothing.  Set 0 only if you also set LLM_SAMPLES=1.
# LLM_TEMPERATURE=0.3

LLM_TIMEOUT=60

# --- Bibliographic lookups -------------------------------------------------
# Crossref asks for a contact address so they can throttle politely rather
# than block you.  Optional, but it makes lookups faster and more reliable.
# CROSSREF_EMAIL=you@example.org

# --- Indico (optional) -----------------------------------------------------
# Only needed for `aiagent indico`, which reads a conference's paper list using
# your own account.  Create a token at <indico>/user/tokens/ with the
# 'read:everything' scope; add 'full:everything' only when sending results back.
# Indico has no narrower scope for the editing module, so that token can do
# anything you can do — name it after this machine so it can be revoked alone,
# and revoke it at the same page when you are done.
# INDICO_URL=https://indico.jacow.org
# INDICO_EVENT=82
# INDICO_TOKEN=indp_...

# Conference settings
JACOW_BODY_PAGES=3               # pages of body text; references may run onto the next
AIAGENT_CACHE_DIR=                # shared lookup cache for both tools; default ~/.cache/aiagent

# House style for this conference (src/house_style.py): jacow | napac | hiat | iso4
HOUSE_STYLE=jacow
# HOUSE_STYLE_UNITS=auto          # auto | qty | tilde   (LaTeX measurements)
# HOUSE_STYLE_PAGE_DASH=hyphen    # hyphen (pp. 57-59) | endash (pp. 57–59)
# HOUSE_STYLE_APOSTROPHE=typographic  # typographic (IPAC’23) | straight (IPAC'23)
# HOUSE_STYLE_APPLIED=App.        # App. (Annex C) | Appl. (ISO 4)
# REFERENCE_CORRECTIONS=true      # lookups may correct the author's values (shown old → new); false = fill gaps only

# Fine-tuned reference model (docs/finetune.md); off unless named
# REFERENCE_MODEL=jacow-refs
# REFERENCE_MODEL_MODE=fallback   # fallback | prefer
